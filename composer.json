{
    "name": "inupress/seo",
    "description": "Search engine basics for Inupress: canonical and Open Graph tags, sitemap.xml and robots.txt",
    "type": "inupress-plugin",
    "keywords": ["inupress", "inupress-plugin"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inupress/contracts": "^0.1",
        "inupress/core": "^0.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Inupress\\Seo\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Inupress\\Seo\\SeoServiceProvider"
            ]
        }
    }
}
